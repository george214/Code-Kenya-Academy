{
  "expo": {
    "name": "Light Code Camp",
    "slug": "lightcodecamp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon_2.png",
    "scheme": "lightcodecamp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon_2.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F0"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lightcodecamp.app"
    },
    "android": {
      "package": "com.lightcodecamp.app"
    },
    "web": {
      "favicon": "./assets/images/icon_2.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}